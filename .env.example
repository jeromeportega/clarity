# Database (Turso)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Mutation token gate — required for all mutation routes (confirm/correct/dismiss/upload).
# Any request missing this header (x-reconcile-token) will receive 401.
# Generate a strong random secret: openssl rand -hex 32
RECONCILE_MUTATION_TOKEN=

# Public demo mode — set to "1" to pin all reads to the demo household.
# Mutations are still gated by RECONCILE_MUTATION_TOKEN regardless of this setting.
PUBLIC_DEMO_MODE=0

# Reconciliation backend: "stub" (default, no external calls) or "live"
RECON_BACKEND=stub
