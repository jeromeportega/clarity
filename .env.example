# Database (Turso). Leave both unset for a local file DB under ./data (or CLARITY_DATA_DIR).
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=
# CLARITY_DATA_DIR=./data

# Receipt images: private Vercel Blob store when set, else <CLARITY_DATA_DIR>/receipt-images.
# BLOB_READ_WRITE_TOKEN=

# Live receipt vision + SKU resolution go through the Vercel AI Gateway. Locally,
# either an API key or the VERCEL_OIDC_TOKEN that `vercel env pull` writes to
# .env.local; on Vercel the deployment's OIDC token is used automatically.
# Without a credential the upload route falls back to recorded fixtures (fine for
# tests, useless for real receipts).
AI_GATEWAY_API_KEY=
# RECEIPT_AI=live            # or `recorded`, to force the choice
# CLARITY_VISION_MODEL=anthropic/claude-opus-5
# CLARITY_RESOLVER_MODEL=anthropic/claude-sonnet-5

# Mutation token gate — required for all mutation routes (confirm/correct/dismiss/upload/ingest).
# Any request missing this header (x-reconcile-token) will receive 401.
# Generate a strong random secret: openssl rand -hex 32
RECONCILE_MUTATION_TOKEN=

# Public demo mode — set to "1" to pin all reads to the demo household, read-only.
# Mutations are still gated by RECONCILE_MUTATION_TOKEN regardless of this setting.
PUBLIC_DEMO_MODE=0

# Sign-in (Clerk). Both set → a signed-in person reads and writes their own
# household; either unset → no sessions (reads need PUBLIC_DEMO_MODE, writes the token).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Who may be given a household on first sign-in (comma-separated emails). Unset → nobody.
# CLARITY_OPERATOR_EMAILS=you@example.com
# Extra origins Clerk session tokens are accepted for (a custom domain); the deployment's own are automatic.
# CLERK_AUTHORIZED_PARTIES=

# Reconciliation backend: leave unset for the DB-backed gateway (default).
# "stub" opts out to hardcoded demo rows — tests and throwaway demos only.
# RECON_BACKEND=stub

# Optional — vision accuracy harness (npm run vision:eval) and Playwright (npm run e2e)
# RECEIPT_EVAL_DIR=
# RECEIPT_EVAL_RATIO=0.85
# E2E_BASE_URL=http://localhost:3000
