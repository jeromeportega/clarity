{
  "name": "clarity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Home management platform — finance module (greenfield).",
  "workspaces": [
    "modules/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "vision:eval": "vitest run --project eval",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "costco:capture": "tsx scripts/costco/capture-receipts.ts",
    "costco:eval-set": "tsx scripts/costco/build-eval-set.ts",
    "dictionary:bootstrap": "tsx scripts/dictionary-bootstrap.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "ai": "7.0.102",
    "drizzle-orm": "^0.36.4",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "drizzle-kit": "^0.28.1",
    "playwright": "^1.60.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  }
}
